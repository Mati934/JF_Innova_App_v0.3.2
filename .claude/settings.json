{
  "permissions": {
    "allow": [
      "mcp__supabase"
    ],
    "ask": [
      "mcp__supabase-write"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/dart-format.js\"",
            "timeout": 30,
            "statusMessage": "dart format"
          }
        ]
      }
    ]
  }
}
